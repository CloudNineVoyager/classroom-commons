      {
        "id": "b1",
        "groupId": "g2",
        "title": "老师示范顺序句与原因句",
        "objective": "老师沿用种子小故事，示范“先……再……最后……”和“因为……所以……”的区别：前者排列事件，后者说明关系。让学生提出一个理由，解释为什么某一步需要放在另一件事之前；合理即可，不宣称所有故事只有一种顺序。",
        "duration": 5,
        "mode": "teacher",
        "requiresReading": false,
        "after": [
          "b0"
        ],
        "needs": [
          {
            "resourceId": "counters",
            "quantity": 10
          }
        ],
        "alternative": null
      },
      {
        "id": "b2",
        "groupId": "g2",
        "title": "无纸卡：石子代表三句，伙伴口头排序",
        "objective": "目标是把三句事件整理成可理解的顺序，并口头解释一个安排理由。原活动需要纸卡，但实际库存为零，须先解决材料缺口，再让学生自主进行。",
        "duration": 5,
        "mode": "independent",
        "requiresReading": false,
        "after": [
          "b1"
        ],
        "needs": [
          {
            "resourceId": "counters",
            "quantity": 10
          }
        ],
        "alternative": null,
        "adaptation": {
          "rationale": "保留“整理事件顺序并解释一个理由”的目标。沿用老师刚示范的三句故事，用三颗石子作记号；一人摆并逐句说，另一人提出一种调整并说明理由，再交换。无需纸张或自主阅读，具体适用性由老师确认。",
          "teacherConfirmed": true
        }
      },
      {
        "id": "b3",
        "groupId": "g2",
        "title": "老师检查顺序与理由是否对应",
        "objective": "请学生展示一个排列并说“我这样排，因为……”。追问理由是否真的解释了这次排列；若有另一种也合理的顺序，让学生比较两种说法，而不是仅凭是否和示范一致判错。",
        "duration": 5,
        "mode": "teacher",
        "requiresReading": false,
        "after": [
          "b2"
        ],
        "needs": [],
        "alternative": null
      },
      {
        "id": "b4",
        "groupId": "g2",
        "title": "伙伴提出另一种顺序并互相追问",
        "objective": "沿用已练过的两人轮流规则：一人讲一个三步日常小故事，另一人尝试调换两句并问“这样还能听懂吗？为什么？”双方说明理由后交换。无需书写或额外材料。",
        "duration": 5,
        "mode": "independent",
        "requiresReading": false,
        "after": [
          "b3"
        ],
        "needs": [],
        "alternative": null
      },
      {
        "id": "b5",
        "groupId": "g2",
        "title": "老师用离堂问题检查顺序表达",
        "objective": "请每人说一句包含“先……再……”的表达，并给一个能解释顺序的理由。老师分别记录“能排列事件”和“能说明理由”，给出下一次需要练习的一个具体点；不把单次表现当作能力定论。",
        "duration": 5,
        "mode": "teacher",

    "tasks": [
      {
        "id": "a1",
        "groupId": "g1",
        "title": "听三步小故事，指出先发生什么",
        "objective": "老师口述自编小故事：“我装好种子，带到花园，种进土里。”说一件，伸一根手指。学生跟着做动作，再说“先装好，再带去，最后种下”。观察学生能否把三个动作按原顺序说出；不要求识字。",
        "duration": 5,
        "mode": "teacher",
        "requiresReading": false,
        "after": [],
        "needs": [],
        "alternative": null
      },
      {
        "id": "a2",
        "groupId": "g1",
        "title": "两人用石子排出故事三步",
        "objective": "沿用刚才示范的玩法，两人轮流用三颗石子代表三件事：摆一颗，说一句；同伴听完用手指指出第一件和最后一件。完成一轮后交换角色。检验能否按顺序复述，不把石子大小或颜色当作对错标准。",
        "duration": 5,
        "mode": "independent",
        "requiresReading": false,
        "after": [
          "a1"
        ],
        "needs": [
          {
            "resourceId": "counters",
            "quantity": 10
          }
        ],
        "alternative": null
      },
      {
        "id": "a3",
        "groupId": "g1",
        "title": "老师听复述，追问前后关系",
        "objective": "请两名学生各说一遍三步故事。老师问：“哪一步先？如果还没带到花园，就说已经在那里种好，哪里需要补一句？”用追问帮助学生修正表达，不要求唯一措辞。记录是否能用“先、再、最后”。",
        "duration": 5,
        "mode": "teacher",
        "requiresReading": false,
        "after": [
          "a2"
        ],
        "needs": [],
        "alternative": null
      },
      {
        "id": "a4",
        "groupId": "g1",
        "title": "同伴轮流说，另一人按顺序摆石子",
        "objective": "复用已经练过的轮流规则。一人说三件连续的小事，另一人依次摆三颗石子；然后一起检查有没有漏掉或重复。学生可以选择熟悉的进教室、整理物品等日常情境，不要求介绍家庭情况。",
        "duration": 5,
        "mode": "independent",
        "requiresReading": false,
        "after": [
          "a3"
        ],
        "needs": [
          {
            "resourceId": "counters",
            "quantity": 10
          }
        ],
        "alternative": null
      },
      {
        "id": "a5",
        "groupId": "g1",
        "title": "老师帮助补全缺少的一步",
        "objective": "老师把一个三步故事故意漏掉中间一步，请学生补出能衔接前后的一句，并说出它应该放在哪里。允许多个合理答案；检查顺序和表达是否清楚，而不是猜老师心里的原句。",
        "duration": 5,
        "mode": "teacher",
        "requiresReading": false,
        "after": [
          "a4"
        ],
        "needs": [],
        "alternative": null
      },
      {
        "id": "a6",
        "groupId": "g1",
        "title": "用三个手势复述并互相核对",
        "objective": "两人继续熟悉的轮流活动，用三个手势标记自己的故事三步，伙伴用手指按一、二、三回应。说完交换角色；有遗漏就请伙伴再说一次。结束时每人准备一句自己最清楚的顺序表达。",
        "duration": 5,
        "mode": "independent",
        "requiresReading": false,
        "after": [
          "a5"
        ],
        "needs": [],
        "alternative": null
      },
      {
